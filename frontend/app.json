{
  "expo": {
    "name": "Makénéné Solidarité",
    "slug": "makenene-solidarite",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "makenene",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#264557"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#264557"
      },
      "edgeToEdgeEnabled": true,
      "icon": "./assets/icon.png"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#FBFDFA"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "apiUrl": ""
    }
  }
}
