APP_NAME="Makénéné Solidarité"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8082
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=makenene-solidarite
DB_USERNAME=root
DB_PASSWORD=
DB_TIMEZONE=+00:00

# Clé séparée, jamais versionnée : requise pour importer le snapshot chiffré si présent.
DATA_EXPORT_KEY=

SESSION_DRIVER=file
SESSION_ENCRYPT=true
CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# Use the SMTP login shown in Brevo > Settings > SMTP & API.
MAIL_USERNAME=
# Use a Brevo SMTP key here, not the API key or account password.
MAIL_PASSWORD=
# This must be an authenticated sender address in Brevo.
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Optional initial global administrator password. Configure privately in .env;
# leave blank to generate a random password during first installation.
SUPER_ADMIN_IDENTIFIER=
SUPER_ADMIN_INITIAL_PASSWORD=
